Cell[BoxData[{
 RowBox[{
  RowBox[{"(", "b", ")"}], " ", "The", " ", "generating", " ", "function", " ",
   "of", " ", "Hermite", " ", "polynomials", " ", "is"}], "\n", 
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"2", 
            StyleBox["x", "TI"], 
            StyleBox["t", "TI"], "-", 
            SuperscriptBox[
             StyleBox["t", "TI"], "2"]}]], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["n", "TI"], "\[LongEqual]", "0"}], "\[Infinity]", 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["H", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         FractionBox[
          SuperscriptBox[
           StyleBox["t", "TI"], 
           StyleBox["n", "TI"]], 
          RowBox[{
            StyleBox["n", "TI"], "!"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "$ e^{2xt - t^2} = \\sum_{n=0}^{\\infty} H_n(x) \\frac{t^n}{n!} $", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], "."}],
  TraditionalForm], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Thus", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubscriptBox[
           StyleBox["H", "TI"], 
           StyleBox["n", "TI"]], "(", 
          StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
      "input" -> "H_n(x)", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "is", " ", "the", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], "-", 
   RowBox[{
   "th", " ", "derivative", " ", "with", " ", "respect", " ", "to", " ", 
    "t"}]}], ",", "\[IndentingNewLine]"}]}], "Text",
 CellChangeTimes->{{4.0026034823865137`*^9, 4.0026035199982853`*^9}, {
   4.002603592825375*^9, 4.002603734084532*^9}, 
   4.002603788194084*^9},ExpressionUUID->"7d577f7a-c5d2-4997-ba45-\
d732486f8ada"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "t", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Extract", " ", "H_n", 
      RowBox[{"(", "x", ")"}], " ", "from", " ", "the", " ", "generating", " ",
       "function", " ", "for", " ", "n"}], " ", "=", " ", "0"}], ",", " ", 
    "1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], " ", "*)"}]}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"2", " ", "x", " ", "t"}], " ", "-", " ", 
         RowBox[{"t", "^", "2"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "k"}], "}"}]}], "]"}], " ", "/.", " ", 
     RowBox[{"t", " ", "->", " ", "0"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], "Code",
 CellChangeTimes->{{4.002603793300111*^9, 4.002603887257704*^9}, 
   4.002603930795657*^9},
 CellLabel->"In[27]:=",ExpressionUUID->"b63a6285-0977-4b01-9b21-b611c4a8e8db"],

