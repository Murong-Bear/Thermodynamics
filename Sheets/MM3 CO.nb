Cell[BoxData[
 RowBox[{
  RowBox[{"For", "  ", 
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["f", "TI"], 
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
          SuperscriptBox[
           StyleBox["x", "TI"], "2"], "/", 
          RowBox[{"(", 
            RowBox[{"1", "+", 
              SuperscriptBox[
               StyleBox["x", "TI"], "2"]}], ")"}]}], TraditionalForm], 
      "errors" -> {}, "input" -> "$f(x) = x^2 / (1 + x^2)$", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm]}], ",", " ", 
  RowBox[{"the", " ", "series", " ", "is", " ", 
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SuperscriptBox[
           StyleBox["x", "TI"], "2"], "-", 
          SuperscriptBox[
           StyleBox["x", "TI"], "4"], "+", 
          SuperscriptBox[
           StyleBox["x", "TI"], "6"], "-", "\[CenterEllipsis]"}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "$x^2 - x^4 + x^6 - \\cdots$", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"],
    TraditionalForm]}], ",", " ", "\n"}]], "Text",
 CellChangeTimes->{{4.0026026130501842`*^9, 4.002602613628264*^9}, {
