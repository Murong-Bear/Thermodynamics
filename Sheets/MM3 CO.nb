Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"rodriquesH", "[", 
      RowBox[{"0", ",", "x"}], "]"}], ",", "1", ",", 
     RowBox[{
      RowBox[{"rodriquesH", "[", 
       RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"rodriquesH", "[", 
      RowBox[{"1", ",", "x"}], "]"}], ",", 
     RowBox[{"2", " ", "x"}], ",", 
     RowBox[{
      RowBox[{"2", " ", "x"}], "\[Equal]", 
      RowBox[{"rodriquesH", "[", 
       RowBox[{"1", ",", "x"}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     RowBox[{"rodriquesH", "[", 
      RowBox[{"2", ",", "x"}], "]"}], ",", 
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["x", "2"]}]}], ",", 
     RowBox[{
      RowBox[{"4", " ", 
       SuperscriptBox["x", "2"]}], "\[Equal]", 
      RowBox[{"2", "+", 
       RowBox[{"rodriquesH", "[", 
        RowBox[{"2", ",", "x"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", 
     RowBox[{"rodriquesH", "[", 
      RowBox[{"3", ",", "x"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "12"}], " ", "x"}], "+", 
      RowBox[{"8", " ", 
       SuperscriptBox["x", "3"]}]}], ",", 
     RowBox[{
      RowBox[{"8", " ", 
       SuperscriptBox["x", "3"]}], "\[Equal]", 
      RowBox[{
       RowBox[{"12", " ", "x"}], "+", 
       RowBox[{"rodriquesH", "[", 
        RowBox[{"3", ",", "x"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", 
     RowBox[{"rodriquesH", "[", 
      RowBox[{"4", ",", "x"}], "]"}], ",", 
     RowBox[{"12", "-", 
      RowBox[{"48", " ", 
       SuperscriptBox["x", "2"]}], "+", 
      RowBox[{"16", " ", 
       SuperscriptBox["x", "4"]}]}], ",", 
     RowBox[{
      RowBox[{"12", "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["x", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "+", 
          SuperscriptBox["x", "2"]}], ")"}]}]}], "\[Equal]", 
      RowBox[{"rodriquesH", "[", 
       RowBox[{"4", ",", "x"}], "]"}]}]}], "}"}]}], "}"}]], "Output",
