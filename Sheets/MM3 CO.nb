Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Define", " ", "the", " ", "function", " ", "and", " ", "its", " ", 
      "six"}], "-", 
     RowBox[{
     "term", " ", "Taylor", " ", "truncation", " ", "about", " ", "x"}]}], 
    " ", "=", " ", "0"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"x", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fTruncated", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"k", " ", "-", " ", "1"}], ")"}]}], " ", 
        RowBox[{"x", "^", 
         RowBox[{"(", 
          RowBox[{"2", " ", "k"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "these", " ", "two", " ", "curves"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", "x", "]"}], ",", " ", 
       RowBox[{"fTruncated", "[", "x", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", " ", "2"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<f(x)\>\"", ",", " ", "\"\<Truncation\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}]}], "\n", 
    "]"}]}]}]], "Code",
