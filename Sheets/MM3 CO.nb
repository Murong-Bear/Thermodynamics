Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"x", ",", " ", "n"}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "Hermite", " ", "polynomials", " ", "using", " ", 
    RowBox[{"Rodrigues", "'"}], " ", "formula"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rodrigues", "[", 
     RowBox[{"n_Integer", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", "n"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"x", "^", "2"}], "]"}], " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"x", "^", "2"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "n"}], "}"}]}], "]"}]}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Display", " ", "the", " ", "first", " ", "five", " ", "Hermite", " ", 
     "polynomials", " ", "and", " ", "compare", " ", "with", " ", 
     RowBox[{"Mathematica", "'"}], "s", " ", "build"}], "-", 
    RowBox[{"in", " ", "Hermite", " ", "polynomials"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", "\n", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", " ", 
      RowBox[{"Expand", "[", 
       RowBox[{"rodriquesH", "[", 
        RowBox[{"k", ",", " ", "x"}], "]"}], "]"}], ",", " ", 
      RowBox[{"HermiteH", "[", 
       RowBox[{"k", ",", " ", "x"}], "]"}], ",", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"rodriquesH", "[", 
         RowBox[{"k", ",", " ", "x"}], "]"}], " ", "==", " ", 
        RowBox[{"HermiteH", "[", 
         RowBox[{"k", ",", " ", "x"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "\n", " ", "]"}], 
  "\n", " ", "\n", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Check", " ", "the", " ", "Hermite", " ", "differential", " ", "equation", 
    " ", "for", " ", "the", " ", "first", " ", "five", " ", "polynomials"}], 
   "*)"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"HermiteH", "[", 
         RowBox[{"k", ",", " ", "x"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}], " ", "-", " ", 
      RowBox[{"2", " ", "x", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"HermiteH", "[", 
          RowBox[{"k", ",", " ", "x"}], "]"}], ",", "x"}], "]"}]}], " ", "+", 
      " ", 
      RowBox[{"2", " ", "k", " ", 
       RowBox[{"HermiteH", "[", 
        RowBox[{"k", ",", "x"}], "]"}]}]}], "\n", "   ", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "\n", " ", 
   "]"}]}]}], "Code",
 CellChangeTimes->{{4.002600809273055*^9, 4.002600832240197*^9}, {
  4.00260086355084*^9, 4.002600865390184*^9}, {4.002600908074031*^9, 
