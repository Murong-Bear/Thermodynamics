5274ddc656c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Build", " ", "the", " ", "finite", " ", "orthogonality", " ", "matrix"}], 
   "*)"}], "\n", "\n", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", "\n", "    ", 
     RowBox[{"Integrate", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"x", "^", "2"}]}], "]"}], " ", 
        RowBox[{"HermiteH", "[", 
         RowBox[{"m", ",", " ", "x"}], "]"}], " ", 
        RowBox[{"HermiteH", "[", 
         RowBox[{"n", ",", " ", "x"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"x", ",", " ", "Reals"}], "]"}]}]}], "\n", "    ", "]"}], 
     "\n", "  ", "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"n", ",", " ", "0", ",", " ", "4"}], "}"}]}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{{4.0026016705952063`*^9, 4.0026017203927517`*^9}, {
   4.002602361706645*^9, 4.002602398935089*^9}, {4.002602488531416*^9, 
