Cell["But how to apply this for n > 2 larger monomial lists???", "Text",
 CellChangeTimes->{{4.001390991334062*^9, 
  4.001391031347027*^9}},ExpressionUUID->"185929f5-86f0-46ab-83a8-\
587074c6cf68"],

Cell["(d) Approximate another function, use f(x) = cos(x) here.", "Text",
 CellChangeTimes->{{4.001391048432077*^9, 4.0013911076875134`*^9}, {
  4.00139117711917*^9, 
  4.001391198690466*^9}},ExpressionUUID->"04fa6bf5-a4d5-4b21-bcd6-\
86595c5fc6c4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"f", ",", " ", "approximation"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Cos", "[", "x", "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", " ", "=", " ", 
    RowBox[{"gramSchmidt", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox["x", "k"], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], ",", 
      " ", "scalarProduct"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coefficients", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", " ", 
        RowBox[{"f", "[", "x", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"approximation", "[", "x_", "]"}], " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"coefficients", "[", 
         RowBox[{"[", 
          RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{"k", "+", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{"Plot", "[", "\n", "  ", 
  RowBox[{"Evaluate", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", " ", 
      RowBox[{"approximation", "[", "x", "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", "\n", "  ", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", 
       RowBox[{"{", 
        RowBox[{"Red", ",", " ", "Dashed"}], "}"}]}], "}"}]}], ",", "\n", 
    "  ", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<f(x)\>\"", ",", " ", "\"\<approximation\>\""}], "}"}]}], ",",
     "\n", "  ", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\""}], "}"}]}], ",", "\n", "  ", 
    
    RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\n", "]"}]}], "Code",
 CellChangeTimes->{{4.001391203842643*^9, 4.0013912852562227`*^9}, {
  4.001391319726886*^9, 4.0013916151798286`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"aff9bab7-34d7-4b62-97b3-a6928c578e00"],

