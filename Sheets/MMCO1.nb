Notebook[{
Cell["C1 (a) Define the scalar product .", "Text",
 CellChangeTimes->{{4.001386689626651*^9, 
  4.0013867859716988`*^9}},ExpressionUUID->"0bb70887-adee-4b73-8a0a-\
f335907252a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"x", ",", " ", "scalarProduct"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scalarProduct", "[", 
    RowBox[{"f_", ",", "g_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Assuming", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{"x", ",", " ", "Reals"}], "]"}], ",", "\n", "  ", 
     RowBox[{"FullSimplify", "[", "\n", "  ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           SuperscriptBox["x", "2"]}], "]"}], " ", "f", " ", "g"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"x", ",", " ", 
          RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}], 
      "]"}]}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{4.001386890411335*^9, 4.001387096599114*^9}, 
   4.001388964359456*^9, 4.001391779475326*^9, {4.001391923979658*^9, 
   4.001391935548161*^9}, 4.001391974878427*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"3b0de58f-5a0e-4291-ad19-ceb69f63ec23"],

Cell["(b) The Gram - Schmidt Procedure", "Text",
 CellChangeTimes->{{4.001386905396269*^9, 4.001386907518997*^9}, {
  4.00138711399301*^9, 
  4.0013872055948277`*^9}},ExpressionUUID->"cb278df9-3f1f-4fb5-b7e7-\
fc91ac1445a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "gramSchmidt", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gramSchmidt", "[", 
    RowBox[{"functions_List", ",", " ", "innerProduct_"}], "]"}], " ", ":=", 
   "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"basis", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", "v"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"FullSimplify", "[", "\n", "        ", 
           RowBox[{"f", " ", "-", " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"innerProduct", "[", 
                   RowBox[{"#", ",", " ", "f"}], "]"}], "/", 
                  RowBox[{"innerProduct", "[", 
                   RowBox[{"#", ",", " ", "#"}], "]"}]}], ")"}], " ", "#"}], 
               " ", "&"}], " ", "/@", " ", "basis"}], "]"}]}], "]"}]}], ";", 
         "\n", "        ", "\n", "      ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"FullSimplify", "[", "\n", "        ", 
           RowBox[{"v", "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"innerProduct", "[", 
              RowBox[{"v", ",", " ", "v"}], "]"}], "]"}]}], "]"}]}], ";", 
         "\n", "        ", "\n", "      ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"basis", ",", " ", "v"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"f", ",", " ", "functions"}], "}"}]}], "]"}], ";", "\n", 
      "    ", "\n", "    ", "basis"}]}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{4.001386905396269*^9, 4.001386907518997*^9}, {
   4.00138711399301*^9, 4.001387195398147*^9}, {4.001387527161138*^9, 
   4.0013879391066933`*^9}, 4.0013917924459877`*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"a43326c1-f013-40f6-ab45-42594028d954"],

Cell["   Then apply it to polynomials, with n = [Input integer]:", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.001386689626651*^9, 4.001386777728505*^9}, {
  4.001387953337034*^9, 4.001387980407639*^9}, {4.001388088058939*^9, 
  4.0013881008891993`*^9}},ExpressionUUID->"df937c91-5d63-4170-81cb-\
94a696dbe1bc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", " ", "=", " ", "2"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"monomials", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      SuperscriptBox["x", "k"], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"polynomials", " ", "=", " ", 
   RowBox[{
    RowBox[{"gramSchmidt", "[", 
     RowBox[{"monomials", ",", " ", "scalarProduct"}], "]"}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}]}], "Code",
 CellChangeTimes->{{4.001388108005698*^9, 4.001388253927997*^9}, {
  4.001388938266313*^9, 4.001388939530056*^9}, {4.001391307897109*^9, 
  4.0013913099224167`*^9}, {4.0013918601232023`*^9, 4.001391861729988*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"a5aa1679-15c2-463e-9b10-9da95d7760c1"],

Cell["  Display", "Text",
 CellChangeTimes->{{4.001388264507077*^9, 
  4.001388268607848*^9}},ExpressionUUID->"c1844c6f-d349-4700-ab0b-\
15f8d373824e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"polynomials", "[", 
        RowBox[{"[", 
         RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k\>\"", ",", " ", "\"\<p_k(x)\>\""}], "}"}]}], "}"}]}]}], 
  "\n", "]"}]], "Code",
 CellChangeTimes->{{4.001388280730398*^9, 4.001388363010412*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"06ec82ed-5b22-439f-abdb-e0307dfb7a96"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"k\"\>",
       HoldForm], 
      TagBox["\<\"p_k(x)\"\>",
       HoldForm]},
     {"0", 
      FractionBox["1", 
       SuperscriptBox["\[Pi]", 
        RowBox[{"1", "/", "4"}]]]},
     {"1", 
      FractionBox[
       RowBox[{
        SqrtBox["2"], " ", "x"}], 
       SuperscriptBox["\[Pi]", 
        RowBox[{"1", "/", "4"}]]]},
     {"2", 
      FractionBox[
       RowBox[{
        SqrtBox["2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], "+", 
          SuperscriptBox["x", "2"]}], ")"}]}], 
       SuperscriptBox["\[Pi]", 
        RowBox[{"1", "/", "4"}]]]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {None, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, TableHeadings -> {None, {"k", "p_k(x)"}}]]]], "Output",
 CellChangeTimes->{4.001388900212064*^9, 4.001391628924507*^9, 
  4.001392313807165*^9},
 CellLabel->
  "Out[9]//TableForm=",ExpressionUUID->"a4764a6d-6cfd-4f7f-93f3-0e0b39437ebd"]
}, Open  ]],

Cell["\<\
(c) Use this program to check answer I calculated from question 4, n = 2\
\>", "Text",
 CellChangeTimes->{{4.001388397835701*^9, 
  4.001388452764062*^9}},ExpressionUUID->"5c495bd4-2b1c-4a62-bcdf-\
1fbe4dfdf477"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gramSchmidt", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "x", ",", " ", 
      SuperscriptBox["x", "2"]}], "}"}], ",", " ", "scalarProduct"}], "]"}], 
  " ", "//", " ", "FullSimplify"}]], "Code",
 CellChangeTimes->{{4.0013884614983397`*^9, 4.001388516566074*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"95ed42b4-5217-4d99-9b74-4b2b0a23e519"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["\[Pi]", 
     RowBox[{"1", "/", "4"}]]], ",", 
   FractionBox[
    RowBox[{
     SqrtBox["2"], " ", "x"}], 
    SuperscriptBox["\[Pi]", 
     RowBox[{"1", "/", "4"}]]], ",", 
   FractionBox[
    RowBox[{
     SqrtBox["2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], "+", 
       SuperscriptBox["x", "2"]}], ")"}]}], 
    SuperscriptBox["\[Pi]", 
     RowBox[{"1", "/", "4"}]]]}], "}"}]], "Output",
 CellChangeTimes->{4.00138890021452*^9, 4.001391628926559*^9, 
  4.0013923140703363`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"bb0b07f1-6ee7-4537-8ca5-2beb38271599"]
}, Open  ]],

Cell["  Then verify orthonormality", "Text",
 CellChangeTimes->{
  4.0013885266396217`*^9, {4.001388605580873*^9, 
   4.001388626460219*^9}},ExpressionUUID->"f456c8e4-f9bc-4b05-ab4e-\
44e42c44449e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", " ", "=", " ", 
    RowBox[{"gramSchmidt", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "x", ",", " ", 
        SuperscriptBox["x", "2"]}], "}"}], ",", " ", "scalarProduct"}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"scalarProduct", "[", 
      RowBox[{
       RowBox[{"\[Phi]", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
       RowBox[{"\[Phi]", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", 
      RowBox[{"Length", "[", "\[Phi]", "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"j", ",", " ", 
      RowBox[{"Length", "[", "\[Phi]", "]"}]}], "}"}]}], "\n", "]"}], " ", "//",
   " ", "MatrixForm"}]}], "Code",
 CellChangeTimes->{{4.001388650515883*^9, 4.001388787313225*^9}, {
  4.001391291895125*^9, 4.001391292095174*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"5abec175-4f7d-472b-a6a0-213a49f65f1a"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "0", "0"},
     {"0", "1", "0"},
     {"0", "0", "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{{4.001388900391285*^9, 4.001388900495232*^9}, 
   4.001391629074891*^9, 4.001392314682828*^9},
